diff --git a/aten/src/ATen/native/cudnn/SDPByteSpan.h b/aten/src/ATen/native/cudnn/SDPByteSpan.h
new file mode 100644
index 0000000..a0adbb5
--- /dev/null
+++ b/aten/src/ATen/native/cudnn/SDPByteSpan.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <ATen/EmptyTensor.h>
+#include <ATen/core/Tensor.h>
+
+#include <cstdint>
+
+namespace at::native::detail {
+
+// Work around cuDNN backward kernels that scale O/dO offsets in 32 bits.
+// Remove once the fixed cuDNN version range is established; see #202035.
+inline bool cudnn_sdpa_needs_packing(const Tensor& tensor, const char* name) {
+  constexpr uint64_t max_byte_span = uint64_t{1} << 32;
+  // Offsets are relative to data_ptr(), not the start of the allocation.
+  const auto span = at::detail::computeStorageNbytes(
+      tensor.sizes(), tensor.strides(), tensor.element_size());
+  if (span <= max_byte_span) {
+    return false;
+  }
+  TORCH_CHECK(
+      at::detail::computeStorageNbytesContiguous(
+          tensor.sizes(), tensor.element_size()) <= max_byte_span,
+      "cuDNN SDPA backward cannot safely handle ",
+      name,
+      " with a compact byte span exceeding 4 GiB. Rerun the forward call "
+      "with a different backend selected by torch.nn.attention.sdpa_kernel().");
+  return true;
+}
+
+} // namespace at::native::detail
