+    @parametrize("dtype", [torch.float16, torch.bfloat16])
+    @parametrize("gapped_first", [False, True])
+    def test_cudnn_attention_backward_alternating_grad_layouts(self, device, dtype, gapped_first):
+        # Different physical layouts with identical logical values must agree,
+        # including when the execution-plan cache is warm.
+        shape = (2, 2, 32, 64)
+        inputs = tuple(torch.randn(shape, device=device, dtype=dtype, requires_grad=True) for _ in range(3))
+        packed = torch.randn(shape, device=device, dtype=dtype)
+        gapped = torch.empty((*shape[:-1], shape[-1] * 2), device=device, dtype=dtype)[..., :shape[-1]]
+        gapped.copy_(packed)
+        reference_inputs = tuple(t.detach().to("cpu", torch.float64).requires_grad_() for t in inputs)
+        with sdpa_kernel(SDPBackend.MATH):
+            reference = F.scaled_dot_product_attention(*reference_inputs)
+        reference_grads = torch.autograd.grad(reference, reference_inputs, packed.to("cpu", torch.float64))
+        layouts = (gapped, packed, gapped) if gapped_first else (packed, gapped, packed)
+        for grad_output in layouts:
+            with sdpa_kernel(SDPBackend.CUDNN_ATTENTION):
+                output = F.scaled_dot_product_attention(*inputs)
+                gradients = torch.autograd.grad(output, inputs, grad_output)
+            for actual, expected in zip(gradients, reference_grads):
+                self.assertEqual(actual.to("cpu", torch.float64), expected, atol=3e-3, rtol=2e-2)
