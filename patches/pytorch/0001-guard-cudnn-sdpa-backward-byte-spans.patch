diff --git a/aten/src/ATen/test/cudnn_sdp_utils_test.cpp b/aten/src/ATen/test/cudnn_sdp_utils_test.cpp
new file mode 100644
index 0000000..519da84
--- /dev/null
+++ b/aten/src/ATen/test/cudnn_sdp_utils_test.cpp
@@ -0,0 +1,30 @@
+#include <gtest/gtest.h>
+
+#include <ATen/ATen.h>
+#include <ATen/native/cudnn/SDPByteSpan.h>
+
+using namespace at;
+
+TEST(CudnnSDPABackward, ByteSpan) {
+  // Meta tensors exercise admission without allocating or dispatching large views.
+  const auto options = TensorOptions().device(kMeta).dtype(kHalf);
+  constexpr int64_t limit = int64_t{1} << 31;
+  const auto needs_packing = [](const Tensor& tensor) {
+    return at::native::detail::cudnn_sdpa_needs_packing(tensor, "test tensor");
+  };
+  EXPECT_FALSE(needs_packing(at::empty({0}, options)));
+  EXPECT_FALSE(needs_packing(at::empty_strided({1, 8}, {limit, 1}, options)));
+  EXPECT_FALSE(needs_packing(at::empty_strided({8, 8}, {0, 1}, options)));
+  EXPECT_FALSE(needs_packing(at::empty_strided({2, 8}, {limit - 16, 1}, options)));
+  EXPECT_FALSE(needs_packing(at::empty_strided({2, 8}, {limit - 8, 1}, options)));
+  EXPECT_TRUE(needs_packing(at::empty_strided({2, 8}, {limit, 1}, options)));
+  EXPECT_FALSE(needs_packing(at::empty({limit}, options)));
+  EXPECT_THROW(needs_packing(at::empty({limit + 1}, options)), c10::Error);
+
+  // A nonzero storage offset does not increase offsets relative to data_ptr().
+  auto offset_view = at::empty({limit + 8}, options).narrow(0, limit, 8);
+  EXPECT_FALSE(needs_packing(offset_view));
+  EXPECT_THROW(
+      needs_packing(at::empty_strided({2, limit}, {2 * limit, 1}, options)),
+      c10::Error);
+}
